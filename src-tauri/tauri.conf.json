{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mac Storage Manager",
  "version": "0.1.1",
  "identifier": "com.macstoragemanager.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mac Storage Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mac-storage-manager.web.app/updates/macos/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCQjFGRjAyMTM0NjQyNEIKUldSTFFrWVRBdit4aTFoMG16ZHUwSy9VTVE0ckRtTVVrNFlVS2o1eFpJL1ExSG5SLzRzNXllMGsK"
    }
  }
}
