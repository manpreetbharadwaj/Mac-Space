# Copy this file to .env (or .env.local) and fill in your Firebase Web app
# config. None of these values are secret — they identify your Firebase
# project to the client, the same way a public API endpoint would — but keep
# them out of version control anyway since they're environment-specific.
#
# See docs/remote-updates-setup.md for exactly where to find these in the
# Firebase console.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Master switch for the whole update/remote-config system. Set to "false" to
# fully disable Firebase calls and the Tauri updater during development —
# the app then always behaves as "current version, no update, no
# maintenance mode". Any other value (or leaving it unset) keeps it enabled.
VITE_UPDATE_CHECK_ENABLED=true

# How long (ms) fetched Remote Config values are considered fresh before a
# check re-fetches from Firebase instead of using the cache. Defaults to
# 3600000 (1 hour) if unset. Lower this during development/testing so a
# published Remote Config change shows up quickly — e.g. 30000 (30s).
VITE_REMOTE_CONFIG_MIN_FETCH_INTERVAL_MS=3600000

# Dev-only: preview one of the update/maintenance states locally without a
# real Firebase project or a published release. Only read in `vite dev` /
# `tauri dev` -- statically compiled out of `npm run build` / `tauri build`,
# so it can never affect a real installed copy of the app. One of:
#   optional            -> non-blocking "New Version Available" dialog
#   mandatory-forced    -> blocking dialog via force_update=true
#   mandatory-minimum   -> blocking dialog via minimum_supported_version
#   maintenance         -> full-screen maintenance takeover
# Leave unset (or remove the line) for normal "up to date" behavior.
# VITE_DEV_UPDATE_SCENARIO=optional
